{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/menu.js": {
      "includeFiles": "themes/**",
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/:slug([a-z0-9-]+)\\.html",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/qr/:token([A-Za-z0-9]{8,16})",
      "destination": "https://xzhbyxvlrxemujrqatbl.supabase.co/storage/v1/object/public/menu-qr/:token.pdf",
      "permanent": false
    },
    {
      "source": "/themes/:path*",
      "destination": "https://dsfabio.com/modelli",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/anteprima/:token",
      "destination": "/api/menu?preview=:token"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "destination": "/api/menu?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
